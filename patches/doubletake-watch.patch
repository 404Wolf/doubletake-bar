@@ -0,0 +1,46 @@
+package daemon
+
+import (
+	"encoding/json"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestWatchPublishesStateChanges(t *testing.T) {
+	d := &Daemon{streams: make(map[string]*activeStream)}
+	server, peer := net.Pipe()
+	defer peer.Close()
+	defer server.Close()
+	done := make(chan struct{})
+	go func() { d.watch(server); close(done) }()
+	dec := json.NewDecoder(peer)
+	peer.SetReadDeadline(time.Now().Add(3 * time.Second))
+	var r Response
+	if err := dec.Decode(&r); err != nil {
+		t.Fatal(err)
+	}
+	if !r.OK || r.State != StateIdle {
+		t.Fatalf("initial: %+v", r)
+	}
+	d.mu.Lock()
+	d.streams["tv"] = &activeStream{device: "TV", deviceIP: "tv", state: StateConnecting}
+	d.unlockAndNotify()
+	if err := dec.Decode(&r); err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Streams) != 1 || r.Streams[0].State != StateConnecting {
+		t.Fatalf("update: %+v", r)
+	}
+	peer.Close()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("watch leaked after disconnect")
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if len(d.watchers) != 0 {
+		t.Fatal("watcher not removed")
+	}
+}
