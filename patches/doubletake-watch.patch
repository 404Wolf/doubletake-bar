+// unlockAndNotify publishes a complete snapshot only when observable state changes.
+// All mutations are protected by mu; slow watchers retain only the newest snapshot.
+func (d *Daemon) unlockAndNotify() {
+	if len(d.watchers) > 0 {
+		snapshot := d.statusResponseLocked(true, "")
+		snapshot.Devices = toDeviceInfos(d.devices)
+		data, _ := json.Marshal(snapshot)
+		if string(data) != d.watchSnapshot {
+			d.watchSnapshot = string(data)
+			for ch := range d.watchers {
+				select {
+				case <-ch:
+				default:
+				}
+				ch <- data
+			}
+		}
+	}
+	d.mu.Unlock()
+}
+
+// watch streams newline-delimited snapshots until the peer disconnects.
+func (d *Daemon) watch(conn net.Conn) {
+	conn.SetDeadline(time.Time{})
+	ch := make(chan []byte, 1)
+	d.mu.Lock()
+	if d.watchers == nil {
+		d.watchers = make(map[chan []byte]struct{})
+	}
+	d.watchers[ch] = struct{}{}
+	snapshot := d.statusResponseLocked(true, "")
+	snapshot.Devices = toDeviceInfos(d.devices)
+	data, _ := json.Marshal(snapshot)
+	ch <- data
+	d.mu.Unlock()
+	defer func() { d.mu.Lock(); delete(d.watchers, ch); d.mu.Unlock() }()
+	closed := make(chan struct{})
+	go func() { var b [1]byte; conn.Read(b[:]); close(closed) }()
+	for {
+		select {
+		case <-closed:
+			return
+		case data := <-ch:
+			conn.SetWriteDeadline(time.Now().Add(10 * time.Second))
+			if _, err := conn.Write(append(data, '\n')); err != nil {
+				return
+			}
+		}
+	}
+}
